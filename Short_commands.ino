void GDP3() { arm_cm_4cm(); delay(100); arm_open(); arm_up(); }
void GDP4() { arm_cm_5cm(); delay(100); arm_open(); arm_up(); }

/*
 * =============================================================================
 *  ForwardBackward_Shorthand.ino - ฟังก์ชันย่อสำหรับเดินหน้า/ถอยหลัง
 * =============================================================================
 *  
 *  ตารางคำสั่งย่อ - เดินหน้า/ถอยหลัง (Forward/Backward)
 *  
 *  | คำสั่งย่อ | คำสั่งเต็ม | คำอธิบาย |
 *  |----------|-----------|----------|
 *  | FD() | Forward() | เดินหน้า |
 *  | FDD(t) | ForwardDelay(time) | เดินหน้าหน่วงเวลา |
 *  | FST(s,t) | ForwardSpeedTime(speed, time) | เดินหน้าตามเวลา |
 *  | FSD(t) | ForwardSpeedDelay(time) | เดินหน้าเร่งความเร็วหน่วงเวลา |
 *  | BK() | Backward() | ถอยหลัง |
 *  | BKD(t) | BackwardDelay(time) | ถอยหลังหน่วงเวลา |
 *  | BST(s,t) | BackwardSpeedTime(speed, time) | ถอยหลังตามเวลา |
 *  | FJS() | ForwardJCStop() | เดินหน้าเช็คแยกหยุด |
 *  | FJ() | ForwardJC() | เดินหน้าเช็คแยก |
 *  | MS() | MotorStop() | หยุดมอเตอร์ |
 * =============================================================================
 */

//=============================================================================
// ฟังก์ชันย่อ - เดินหน้า (Forward)
//=============================================================================

// FD() - เดินหน้า
void FD() {
  Forward();
}

// FDD(t) - เดินหน้าหน่วงเวลา
void FDD(int time) {
  ForwardDelay(time);
}

// FST(s,t) - เดินหน้าตามความเร็วและเวลา
void FST(int speed, int time) {
  ForwardSpeedTime(speed, time);
}

// FSD(t) - เดินหน้าเร่งความเร็วหน่วงเวลา
void FSD(int time) {
  ForwardSpeedDelay(time);
}

//=============================================================================
// ฟังก์ชันย่อ - ถอยหลัง (Backward)
//=============================================================================

// BK() - ถอยหลัง
void BK() {
  Backward();
}

// BKD(t) - ถอยหลังหน่วงเวลา
void BKD(int time) {
  BackwardDelay(time);
}

// BST(s,t) - ถอยหลังตามความเร็วและเวลา
void BST(int speed, int time) {
  BackwardSpeedTime(speed, time);
}

//=============================================================================
// ฟังก์ชันย่อ - ตรวจจับแยก (Junction Check)
//=============================================================================

// FJS() - เดินหน้าเช็คแยกหยุด
void FJS() {
  ForwardJCStop();
}


//=============================================================================
// ฟังก์ชันย่อ - หยุดมอเตอร์
//=============================================================================

// MS() - หยุดมอเตอร์
void MS() {
  MotorStop();
}
