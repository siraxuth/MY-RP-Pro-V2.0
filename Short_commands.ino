
// =============================================================================
//  TJCSS Functions
// =============================================================================

void TJCSS(int line) { // เดิน  TracjCSpeed ไปตามจำนวนที่กำหนดแล้ว TracJC(); เพื่อเตรียมเลีี้ยว
  for (int i = 0; i < line; i++) {
    TracJCSpeed();
  }
  TracJC();
  MotorStop();
}

void TJCSS() { TJCSS(1); } // เหมือนคำสั่ง TJCSS(); แต่จะเป็นการ TracJCSpeed() เพียงครั้งเดียว

void TJCSSL(int line) { // TracJCSpeed ไปก่อน แล้วชลอความเร็วเป็น TracJCSlow(); ในกรณีที่เส้นนั้นหลุดบ่อยๆ
  for (int i = 0; i < line; i++) {
    TracJCSpeed();
  }
  TracJCSlow();
  MotorStop();
}

void TJCSSL() { TJCSSL(1); } // เหมือน TJCSSL(); แต่จำเป็นการ TracJCSpeed(); แค่ครั้งเดียว

void TJCSSL2(int line) { // เป็นการใช้ TracJC(); เพื่อไปแบบ speed ธรรมดา และใช้ TacJCSlow(); ในกรณีที่ต้องผ่านแยกที่หลุดบ่อยๆ
  for (int i = 0; i < line; i++) {
    TracJC();
  }
  TracJCSlow();
  MotorStop();
}

void TJCSSL2() { TJCSSL2(1); }

void TJCSSA(int line, int Tracs) { 
  for (int i = 0; i < line; i++) {
    TracJCSpeed();
  }
  for (int a = 0; a < Tracs; a++) {
    TracJC();
  }
  MotorStop();
}

void TJCSSB(int line, int Tracc) {
  for (int i = 0; i < line; i++) {
    TracJCSpeed();
  }
  for (int a = 0; a < Tracc; a++) {
    TracJCSlow();
  }
  MotorStop();
}


