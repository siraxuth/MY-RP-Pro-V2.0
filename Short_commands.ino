/*
 * =============================================================================
 *  Turn_Shorthand.ino - ฟังก์ชันย่อสำหรับเลี้ยว
 * =============================================================================
 *
 *  ตารางคำสั่งย่อ - เลี้ยว (Turn)
 *
 *  | คำสั่งย่อ | คำสั่งเต็ม | คำอธิบาย |
 *  |----------|-----------|----------|
 *  | TL() | TurnLeft() | เลี้ยวซ้าย (ใช้ TurnSpeed) |
 *  | TL(s) | TurnLeft(speed) | เลี้ยวซ้าย กำหนดความเร็ว |
 *  | TR() | TurnRight() | เลี้ยวขวา (ใช้ TurnSpeed) |
 *  | TR(s) | TurnRight(speed) | เลี้ยวขวา กำหนดความเร็ว |
 *  | UTL() | UTurnLeft() | กลับตัวซ้าย (ใช้ TurnSpeed) |
 *  | UTL(s) | UTurnLeft(speed) | กลับตัวซ้าย กำหนดความเร็ว |
 *  | UTR() | UTurnRight() | กลับตัวขวา (ใช้ TurnSpeed) |
 *  | UTR(s) | UTurnRight(speed) | กลับตัวขวา กำหนดความเร็ว |
 *  | LT(s,t) | Left(speed, time) | หมุนซ้ายตามเวลา |
 *  | RT(s,t) | Right(speed, time) | หมุนขวาตามเวลา |
 *  | TLD(s,t) | TurnLeftDelay(speed, time) | เลี้ยวซ้ายหน่วงเวลา |
 *  | TRD(s,t) | TurnRightDelay(speed, time) | เลี้ยวขวาหน่วงเวลา |
 *  | CL(s,t) | CurveLeft(speed, time) | โค้งซ้ายอ้อมสิ่งกีดขวาง |
 *  | CR(s,t) | CurveRight(speed, time) | โค้งขวาอ้อมสิ่งกีดขวาง |
 *  | TLB(s) | TurnLeftBack(speed) | เลี้ยวซ้ายเช็คเซ็นเซอร์หลัง |
 *  | TRB(s) | TurnRightBack(speed) | เลี้ยวขวาเช็คเซ็นเซอร์หลัง |
 *  | TLS(s,n) | TurnLeftSensor(speed, sensor) | เลี้ยวซ้ายจนเจอเซ็นเซอร์ที่กำหนด |
 *  | TRS(s,n) | TurnRightSensor(speed, sensor) | เลี้ยวขวาจนเจอเซ็นเซอร์ที่กำหนด |
 * =============================================================================
 */

//=============================================================================
// ฟังก์ชันย่อ - เลี้ยวซ้าย (Turn Left)
//=============================================================================

// TL() - เลี้ยวซ้าย (ใช้ TurnSpeed)
void TL()
{
  TurnLeft();
}

// TL(s) - เลี้ยวซ้าย กำหนดความเร็ว
void TL(int speed)
{
  TurnLeft(speed);
}

//=============================================================================
// ฟังก์ชันย่อ - เลี้ยวขวา (Turn Right)
//=============================================================================

// TR() - เลี้ยวขวา (ใช้ TurnSpeed)
void TR()
{
  TurnRight();
}

// TR(s) - เลี้ยวขวา กำหนดความเร็ว
void TR(int speed)
{
  TurnRight(speed);
}

//=============================================================================
// ฟังก์ชันย่อ - กลับตัวซ้าย (U-Turn Left)
//=============================================================================

// UTL() - กลับตัวซ้าย (ใช้ TurnSpeed)
void UTL()
{
  UTurnLeft();
}

// UTL(s) - กลับตัวซ้าย กำหนดความเร็ว
void UTL(int speed)
{
  UTurnLeft(speed);
}

//=============================================================================
// ฟังก์ชันย่อ - กลับตัวขวา (U-Turn Right)
//=============================================================================

// UTR() - กลับตัวขวา (ใช้ TurnSpeed)
void UTR()
{
  UTurnRight();
}

// UTR(s) - กลับตัวขวา กำหนดความเร็ว
void UTR(int speed)
{
  UTurnRight(speed);
}

//=============================================================================
// ฟังก์ชันย่อ - หมุนตามเวลา
//=============================================================================

// LT(s,t) - หมุนซ้ายตามเวลา
void LT(int speed, int time)
{
  Left(speed, time);
}

// RT(s,t) - หมุนขวาตามเวลา
void RT(int speed, int time)
{
  Right(speed, time);
}

//=============================================================================
// ฟังก์ชันย่อ - เลี้ยวหน่วงเวลา
//=============================================================================

// TLD(s,t) - เลี้ยวซ้ายหน่วงเวลา
void TLD(int speed, int time)
{
  TurnLeftDelay(speed, time);
}

// TRD(s,t) - เลี้ยวขวาหน่วงเวลา
void TRD(int speed, int time)
{
  TurnRightDelay(speed, time);
}

//=============================================================================
// ฟังก์ชันย่อ - โค้งอ้อมสิ่งกีดขวาง
//=============================================================================

// CL(s,t) - โค้งซ้ายอ้อมสิ่งกีดขวาง
void CL(int speed, int time)
{
  CurveLeft(speed, time);
}

// CR(s,t) - โค้งขวาอ้อมสิ่งกีดขวาง
void CR(int speed, int time)
{
  CurveRight(speed, time);
}

//=============================================================================
// ฟังก์ชันย่อ - เลี้ยวเช็คเซ็นเซอร์หลัง
//=============================================================================

// TLB(s) - เลี้ยวซ้ายเช็คเซ็นเซอร์หลัง
void TLB(int speed)
{
  TurnLeftBack(speed);
}

// TRB(s) - เลี้ยวขวาเช็คเซ็นเซอร์หลัง
void TRB(int speed)
{
  TurnRightBack(speed);
}

//=============================================================================
// ฟังก์ชันย่อ - เลี้ยวจนเจอเซ็นเซอร์ที่กำหนด
//=============================================================================

// TLS(s,n) - เลี้ยวซ้ายจนเจอเซ็นเซอร์ที่กำหนด
void TLS(int speed, int sensor)
{
  TurnLeftSensor(speed, sensor);
}

// TRS(s,n) - เลี้ยวขวาจนเจอเซ็นเซอร์ที่กำหนด
void TRS(int speed, int sensor)
{
  TurnRightSensor(speed, sensor);
}

